	(text "Footprints:\n1x 1812\n1x 2220\n2x 1210"
		(exclude_from_sim no)
		(at 153.162 79.248 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5f0b7218-8d75-4683-bc40-2ffacadb515a")
	)
	(text "LTSpice simulations show a power factor \n> 0.75 across component tolerances and \na frequency range of 30 kHz - 33 kHz. \nThe tolerance on the transducer \nspecifications is unknown so additional \nparallel capacitors help in tuning the \nmatching network for a frequency and \ntransducer selected. Component valus \nwere determined numerically using LTSpice"
		(exclude_from_sim no)
		(at 68.072 66.802 0)
		(effects
			(font
				(size 1.905 1.905)
			)
			(justify left)
		)
		(uuid "701258cb-b6be-4b43-9217-34248c18fae8")
	)
	(text "Impedance Matching Network Between \nPower Amplifier and Transducer"
		(exclude_from_sim no)
		(at 196.088 53.594 0)
		(effects
			(font
				(size 2.54 2.54)
			)
		)
		(uuid "720ca815-3a04-4f48-86f8-54e6e28ea479")
	)
	(text "SRR1280 series of inductors chosen for their\nwide range of inductances available, their\nrelatively high saturation currents, and their\nrelatively low DCRs (0.3 ohms for 180u)"
		(exclude_from_sim no)
		(at 138.684 127.508 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7c0431e4-4d77-4181-9b26-a84838a4b8fe")
	)
	(text "TVS diode capacitance is < 1.5 nF so assuemd to be negigible\nfor the matching network. TVS diode exists to protect\nSSR which has an absolute max voltage of 100V. Breakdown\nboltage of 86.7V"
		(exclude_from_sim no)
		(at 176.022 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "94b9e4d5-7ef1-4d08-8253-a3b2a3aabd9b")
	)
	(text "Note:\nOnly use ceramic capacitors with a\nC0G/NP0 dielectric for stability\nover voltage and temperature as\nthis is very sensitive to component\nvalues"
		(exclude_from_sim no)
		(at 74.93 143.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c118cb1f-b7e6-47b9-86ab-eee037263e57")
	)
	(text "Optional capacitors to tune the impedance matching network"
		(exclude_from_sim no)
		(at 182.88 73.152 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d6074c3f-1bea-4788-83a3-d2b93978cb1e")
	)
