	(text "Oscillator has a rated load capcitance\nof 10 pF. Pin capacitance is 5 pF and\n1cm of 6mil traces is 1 pF.\n10 pF = C_L/2 + (5+1) pF\n-> C_L = 8 pF"
		(exclude_from_sim no)
		(at 133.096 160.528 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "984bd9eb-b9b0-457a-aeb1-c710f7cca4f5")
	)
	(text "Flexible GPIO pins shared with daughter card. One\npin designated as an input while the other is an\noutput. Can either be used for sleep, data interrupt\netc."
		(exclude_from_sim no)
		(at 147.32 110.998 0)
