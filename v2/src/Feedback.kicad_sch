	(text "Feedback network for the pre-amplifier to\ndetermine if the gain is working properly"
		(exclude_from_sim no)
		(at 182.626 48.006 0)
		(effects
			(font
				(size 1.905 1.905)
			)
		)
		(uuid "5e2d4279-f96b-4aac-9204-3f69f2a80470")
	)
	(text "Feedback network from the transmission since the voltage\ncan exceed the maximum rating of the relay (200V) if not\ncontrolled properly. There is also a TVS diode\nwith a breakdown voltage of ~150V. This network ensures\nthe TVS is not constantly working during transmission.\nVoltage divider set to a ratio of 100 to read +/- 150V on\nmicrocontroller 3.3V ADC"
		(exclude_from_sim no)
		(at 32.004 110.998 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "777875ae-7124-4358-a5ef-6c986e4020be")
	)
	(text "Output voltage feedback network"
		(exclude_from_sim no)
		(at 73.152 57.404 0)
