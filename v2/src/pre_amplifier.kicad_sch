				(size 1.27 1.27)
			)
		)
		(uuid "401caaa4-5f87-40cb-b713-743c0dee9ef4")
	)
	(text "Simulations show slightly less gain (65.5 dB at 30 kHz) than expected likely due to the filters on each stage"
		(exclude_from_sim no)
		(at 227.838 25.908 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4da74a12-f69e-4642-bc38-20dc2f23975a")
	)
	(text "LM6211 chosen for low input bias current, high GBW, and low noise.\nBias current: 1 pA\nGBW: 17 MHz (Technically inadequate, but can calibrate)\nNoise @ 30 kHz: 5.5 nV/sqrt(Hz)\nPSRR at 250 kHz: 90 (V+), 40 dB (V-)\nIq: 1 mA\nOffset voltage: up to 2.5 mV, 0.1 mV typ"
		(exclude_from_sim no)
		(at 57.15 41.656 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a6a8e777-8157-439d-bd06-4d53cb4bfff6")
	)
	(text_box "Gain: 35dB = 56x\nPreamplifier set for 50kHz"
		(exclude_from_sim no)
		(at 58.928 141.732 0)
		(size 44.45 5.588)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4268e5c8-899c-4594-8a22-0d7488ebf5d8")
	)
	(text_box "Notes:\n	-Overall Low Circuit Noise\n	-Some non-linearities\n	-Potential Harmonic Distortion if freq too high\n	-SNR ratio of ~84dB\n	-Noise Voltage of ~0.3uV\n	-RIAA curve within 0.1dB\n\n2-stage pre-amplifier was chosen as single stage solutions with sufficient GBW and a sufficiently low input voltage offset were too expensive and a 2-stage amplifier allows for easier control of the gain through the feedback resistors in the second stage\n\nTotal Gain = 70dB\n\nPDF for calculations:\nhttps://www.ti.com/lit/an/snoa586d/snoa586d.pdf"
		(exclude_from_sim no)
		(at 215.9 110.49 0)
		(size 64.77 43.18)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(face "KiCad Font")
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "48242f14-f56c-468d-b283-48df8786bb0f")
	)
