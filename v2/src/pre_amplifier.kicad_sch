	(text "Input noise sources:\n1k input impedance @ 25C: ~4.1 nV/sqrt(Hz)\nPre-amp: 5.5 nV/sqrt(Hz)\nTraces: ? TBD\nCombined: > 6.9 nV/sqrt(Hz)"
		(exclude_from_sim no)
		(at 13.462 103.632 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1fb83c01-9b2c-4932-b64b-a3f6229bab8c")
	)
	(text "Second Amplification Stage"
		(exclude_from_sim no)
		(at 166.37 123.19 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3c4d9c32-b208-49ec-87f9-3ca76f3b2e81")
	)
	(text "First Amplification Stage"
		(exclude_from_sim no)
		(at 77.47 139.7 0)
		(effects
