		(uuid "3ead6d13-be48-4ff0-9a0d-62ba686469e9")
	)
	(text "Place CLK, DIR, NXT resistors near PHY\nPlace DATA, STP resistors near uC"
		(exclude_from_sim no)
		(at 102.108 129.286 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "53bc53d8-e3ec-4803-9a4c-2c136c760bad")
	)
	(text "Place PHY as close as possible to DIR and NXT pins\nas in the uC they are connected to a ~300 ohm analog\nswitch. Forum posts mention issues with external\nULPI on STM32H7 100-LQFP in particular. Prioritize\nthese traces"
		(exclude_from_sim no)
		(at 133.35 151.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "762369e7-2dfe-4f8f-b3f6-efa4a3bd3117")
	)
	(text "P-Channel MOSFET for RPP:\nR_DS(on) = 12mOhm\nV_DS(max) = -60V\nV_GS(max) = +/- 20V\n"
		(exclude_from_sim no)
		(at 226.568 71.374 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "be0413fd-7676-4dd6-a7dc-22f6b62f67b2")
	)
	(text "Rated load capacitance of 20 pF. \nAssuming 1cm traces and PHY \ncapacitance of 4pF.\n\n20 pF = C_L / 2 + (4+1)\n-> C_L = 30 pF"
		(exclude_from_sim no)
		(at 30.226 184.404 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
