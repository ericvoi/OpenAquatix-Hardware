	(text "Doubles as current setting resistor for PhotoMOS\nand gate resistor for reed relay"
		(exclude_from_sim no)
		(at 80.264 93.472 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0d683a3e-8ebd-445d-a725-1702b53e2273")
	)
	(text_box "Typical relays ruled out as TR switch since they have a limited number of switching cycles, high power consumption and the fact that a low-voltage signal would need to be far away from the ground plane, significantly increasing the noise in the high impedance trace\n\nReed relay chosen for Tx TR switch since they offer low contact resistance and lots of switching cycles while remaining acceptably low power. The open contact caapcitance is high at 0.7 pF which could cause issues although unlikely. The high capacitance prevents it from being used for the Rx TR switch as too much voltage would pass through\n\nHigh voltage SSR chosen for Rx TR switch since high voltage and low power which is vital for light sleep mode. The on-state resistance of 17 - 25 ohms is acceptable since the input impedance is 1k"
		(exclude_from_sim no)
		(at 25.4 33.02 0)
		(size 86.36 30.48)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d3a3c9c4-2e4a-43cd-8703-0d11b419e32d")
	)
