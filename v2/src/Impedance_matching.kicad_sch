		(uuid "09a244ea-cef3-4f34-a565-63aaa66a26dc")
	)
	(text "LTSpice simulations show a power factor \n> 0.5 across component tolerances and \na frequency range of 26.7 kHz - 36.5 kHz. \nThe tolerance on the transducer \nspecifications is unknown so additional \nparallel capacitors help in tuning the \nmatching network for a frequency and \ntransducer selected. Component values \nwere determined numerically using LTSpice"
		(exclude_from_sim no)
		(at 26.162 36.322 0)
		(effects
			(font
				(size 1.905 1.905)
			)
			(justify left)
		)
		(uuid "105916a7-8058-4a48-8d85-417593f62fd3")
	)
	(text "Note:\nOnly use ceramic capacitors with a\nC0G/NP0 dielectric for stability\nover voltage and temperature as\nthis is very sensitive to component\nvalues"
		(exclude_from_sim no)
		(at 127 28.702 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5e7cdccd-0486-42aa-af89-d250efef6e84")
	)
