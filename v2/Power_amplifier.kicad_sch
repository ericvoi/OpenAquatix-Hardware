		(uuid "1c1adace-1b12-4682-99a9-d97bcf113ff9")
	)
	(text "FREQ_ADJ determines frame rate for \nAM interference avoidance.\nCurrently set for nominal and \nmaster mode"
		(exclude_from_sim no)
		(at 156.21 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "21e8f16d-b2ee-4eca-958b-5cda46979d22")
	)
	(text "1uF decoupling caps should be placed\n as close as possible to PVDD pins"
		(exclude_from_sim no)
		(at 120.65 21.59 0)
		(effects
			(font
				(size 1.016 1.016)
			)
		)
		(uuid "2dbfcdbe-f586-4432-87db-9e48028c62d5")
	)
	(text "High Side Simultaneous Power Switching\nSTM32 needs to output HIGH for TPA3244\nto be powered.\n*If layout is difficult, dual channel\nPMOS can be changed to two single PMOS"
		(exclude_from_sim no)
		(at 24.13 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "302e1ff1-0b61-471c-9f94-5819e072bde6")
	)
	(text "Using same RC snubber\nas before, may need \ntweaking"
		(exclude_from_sim no)
		(at 247.904 33.274 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "344f7979-df9e-4f98-b434-3e55bb23b0ff")
	)
	(text "Recommended to release RESET after power supply is settled\nfor minimum turn on audible artefacts.\nNote: Asserting RESET low initiates device ramp down and \nforces FAULT high.\nFor thermal reliability, rising edge of RESET must occur\nno sooner than 4ms after falling edge of FAULT."
		(exclude_from_sim no)
		(at 93.98 168.91 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "472f8a50-adbc-4e3a-8351-39b159d8ec7f")
	)
	(text "M2 M1 = 1 0 for PBTL"
		(exclude_from_sim no)
		(at 169.926 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "55410b7a-7ea4-415a-9817-da62ab6b5a09")
	)
	(text "Recommended to monitor CLIP_OTW and respond\nto OTE by turning down volume to prevent\noverheating of device."
		(exclude_from_sim no)
		(at 229.616 151.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "67bea351-4ac3-4007-ac70-d2022df82f8f")
	)
	(text "OC_ADJ resistor sets protection mode\n(CB3C or Latched OC)\nand OC threshold, between 22k and 64k."
		(exclude_from_sim no)
		(at 179.324 105.664 0)
		(effects
			(font
				(size 1.016 1.016)
			)
		)
		(uuid "7bdb29d1-6b4a-46ee-a4e8-cbd1aa2b2001")
	)
	(text "RC filters separate VDD \nand GVDD, as recommended\nin datasheet."
		(exclude_from_sim no)
		(at 126.238 50.292 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "c8b8752c-57a9-4c3d-b67e-cbc4c6b94c09")
	)
	(text "At 155C, device enters thermal shutdown and\ndevice must be reset to resume normal operation."
		(exclude_from_sim no)
		(at 229.616 156.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "cc9e6564-caef-4f9d-a0e8-a420a808975c")
	)
	(text "FAULT and CLIP_OTW have internal pullups to 3.3V"
		(exclude_from_sim no)
		(at 229.616 159.258 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "f99c060a-9eca-44dd-a0db-b6612a7b0dfd")
	)
	(text "RC Snubber"
		(exclude_from_sim no)
		(at 252.73 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "fe5091a6-5f13-49ad-8e66-b944ed99f1a0")
	)
