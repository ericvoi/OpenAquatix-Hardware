	(text "Coupling circuit with a \ncutoff frequency of 159 Hz"
		(exclude_from_sim no)
		(at 98.806 112.014 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a52fe3a3-4626-4fe2-a31a-0d8a47948b92")
	)
	(text "Diode and voltage buffer to suitably clamp the voltage\nfrom the LPF to prevent damage to the PGA as it can\nonly tolerate -0.1 - 3.4V"
		(exclude_from_sim no)
		(at 131.064 131.064 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b72fc284-d8b5-449a-9cb9-fb00d5e8712d")
	)
	(text "PGA has software-shutdown, with \nquiescent current <5uA, opted to save\ncomplexity by leaving out MCU controlled\npower switch. There is a 20 pin version\nof this PGA with hardware shutdown as well."
		(exclude_from_sim no)
		(at 186.944 80.518 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ed000616-58dd-49d0-9109-676e7ae5f1f7")
	)
	(text "1.65V reference"
		(exclude_from_sim no)
		(at 74.93 55.626 0)
		(effects
			(font
				(size 1.905 1.905)
			)
			(justify left)
		)
		(uuid "fbf9133c-5ee5-4313-bd51-b2bff70abd60")
	)
	(text_box "Notes:\n	-Connected to ADC\n	-Channel 0 disconnected\n	-PGA enables a wider range of input voltages to\n	be read by the STM32\n	-HPF, diodes, and voltage follower to ensure that\n	the input voltage to the PGA113 is in range\n	-The protection circuitry likely will not last\n	for continuous over-voltage events so if an over\n	voltage is detected then the gain should be\n	decreased or in the worst-case scenario the\n	input should be disabled entirely\n"
		(exclude_from_sim no)
		(at 173.99 46.99 0)
		(size 62.23 25.4)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
